UPSTAGE_API_KEY=your_upstage_api_key_here
UPSTAGE_API_BASE=https://api.upstage.ai/v1

# Solar 모델명 설정
UPSTAGE_SOLAR_MODEL_CRITIC=solar-pro2
UPSTAGE_SOLAR_MODEL_BLOG=solar-pro2
UPSTAGE_SOLAR_MODEL_IE=solar-pro2

# Document Parse 최대 PDF 크기(바이트). 기본 20MB. 초과 시 413 오류 발생
# UPSTAGE_DOCUMENT_MAX_BYTES=20971520

# Document Parse API read timeout(초). 기본 300초. Read timed out 시 600 등으로 늘리기
# UPSTAGE_DOCUMENT_PARSE_TIMEOUT=300

# Notion 설정 (두 가지 변수명 모두 지원)
NOTION_TOKEN=your_notion_integration_token_here
NOTION_PORTFOLIO_DB_ID=your_database_id_here
# 또는
NOTION_API_KEY=your_notion_integration_token_here
NOTION_DATABASE_ID=your_database_id_here

# 이미지 스토리지 (둘 중 하나만 설정해도 됨)
#
# [권장] GitHub 자동 업로드: 저장 시 이미지를 자동으로 GitHub에 올리고 Notion에 반영
# GitHub → Settings → Developer settings → Personal access tokens → repo 권한으로 토큰 생성
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_IMAGE_REPO=choihyun-1110/my-portfolio-images
GITHUB_IMAGE_BRANCH=main
#
# [선택] 수동 URL: 이미 직접 올려둔 경우에만
# STORAGE_PUBLIC_BASE_URL=https://raw.githubusercontent.com/choihyun-1110/my-portfolio-images/main/assets
